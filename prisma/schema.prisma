generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id        String   @id @default(cuid())
  name      String   @unique
  price     Float
  active    Boolean  @default(true)   // <-- ADICIONAR ESTE CAMPO
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     OrderItem[]
}

model Table {
  id        String   @id @default(cuid())
  number    Int      @unique
  createdAt DateTime @default(now())
  orders    Order[]  // Uma mesa pode ter vários pedidos (histórico)
}

model Order {
  id        String      @id @default(cuid())
  tableId   String
  table     Table       @relation(fields: [tableId], references: [id])
  status    OrderStatus @default(OPEN)
  total     Float       @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]
}

model OrderItem {
  id         String   @id @default(cuid())
  quantity   Int      @default(1)
  unitPrice  Float    // Preço do produto no momento do pedido (congelado)
  orderId    String
  productId  String
  order      Order    @relation(fields: [orderId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
}

model GerenteConfig {
  id        String   @id  // <-- remova @default("single")
  senha     String   // senha do gerente (em texto plano, mas depois podemos melhorar)
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  OPEN
  WAITING_PAYMENT
  CLOSED
}